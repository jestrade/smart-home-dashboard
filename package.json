{
  "name": "smart-home-dashboard",
  "private": true,
  "type": "module",
  "scripts": {
    "setup": "npm --prefix web install && npm --prefix functions install",
    "demo": "npm --prefix web run demo",
    "local:functions": "firebase emulators:start --only functions",
    "local:web": "npm --prefix web run dev:local",
    "emulators": "firebase emulators:start --only auth,firestore,functions",
    "build": "npm --prefix web run build",
    "deploy": "firebase deploy --only functions,hosting,firestore"
  }
}
