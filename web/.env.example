# Copy to .env.local and fill in from Firebase console → Project settings → Your apps → Web app.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# true = talk to the local Firebase emulators instead of the cloud project.
VITE_USE_EMULATORS=false

# true = run with sample devices and no backend at all (also used when no Firebase config is set).
VITE_DEMO=false

# App Check: a reCAPTCHA v3 site key (register it in Firebase Console → App Check). Leave empty to skip.
VITE_RECAPTCHA_SITE_KEY=
